rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'reach.lastminute@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Candidate Rules ---
    function isValidCandidate(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.post in ["President", "Vice President", "Honorary Secretary", "Cabinet Member", "Court Member"] &&
             data.facultyCategory is string &&
             (data.supportsCount == null || data.supportsCount is number);
    }

    match /candidates/{candidateId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCandidate(incoming());
      allow delete: if isAdmin();
      allow update: if (
        isAdmin() && isValidCandidate(incoming())
      ) || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['supportsCount', 'updatedAt']) &&
        incoming().supportsCount is number &&
        (incoming().supportsCount == existing().supportsCount + 1 || incoming().supportsCount == existing().supportsCount - 1 || incoming().supportsCount == 0)
      );
    }

    // --- Vote Rules ---
    function isValidVote(data) {
      return data.userId == request.auth.uid &&
             data.email == request.auth.token.email &&
             (data.cabinetMemberIds == null || (data.cabinetMemberIds is list && data.cabinetMemberIds.size() <= 10));
    }

    match /votes/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidVote(incoming());
      allow update: if (isOwner(userId) && isValidVote(incoming())) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // --- Admin Rules ---
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via console or backend
    }
  }
}
